# ================================================================
# Jarvis V2 - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control!
#
# Quick Setup: python setup_apis.py
# Full Guide: API_CONFIGURATION_GUIDE.md
# ================================================================

# ================================================================
# AI PROVIDERS (Choose one primary, others are optional fallbacks)
# ================================================================

# Groq AI (RECOMMENDED - Fastest, Free tier available)
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Alternative - Most capable, requires billing)
# Get key at: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Alternative - Best for safety)
# Get key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ================================================================
# EMAIL (Gmail with App Password)
# ================================================================
# Requires 2FA enabled on Google account
# Generate App Password at: https://myaccount.google.com/apppasswords

JARVIS_EMAIL_ADDRESS=you@example.com
JARVIS_EMAIL_APP_PASSWORD=your_email_app_password_here
JARVIS_SMTP_HOST=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_IMAP_HOST=imap.gmail.com

# ================================================================
# TWILIO (WhatsApp & Phone Calls)
# ================================================================
# Get credentials at: https://console.twilio.com
# Free trial includes $15 credit

TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_FROM_PHONE=+15551234567
# TwiML URL for call handling (optional)
TWILIO_TWIML_URL=

# ================================================================
# SPOTIFY (Music Control)
# ================================================================
# Get credentials at: https://developer.spotify.com/dashboard
# Set Redirect URI to: http://localhost:8888/callback

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ================================================================
# HOME ASSISTANT (Smart Home)
# ================================================================
# Get token from your Home Assistant profile page
# Long-Lived Access Tokens section

HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_home_assistant_long_lived_token_here

# ================================================================
# WAKE-ON-LAN (Wake sleeping PCs)
# ================================================================
# Find MAC address: ipconfig /all (Windows) or ifconfig (Linux/Mac)

JARVIS_TARGET_PC_MAC=AA:BB:CC:DD:EE:FF
JARVIS_TARGET_PC_BROADCAST=255.255.255.255

# ================================================================
# ADVANCED SETTINGS (Optional)
# ================================================================

# TTS Engine: auto | edge | pyttsx3 | system
# JARVIS_TTS_ENGINE=auto

# Edge TTS Voice (if using edge engine)
# JARVIS_EDGE_VOICE=en-US-GuyNeural

# ================================================================
# SECURITY NOTES
# ================================================================
# 1. This file is in .gitignore - never commit it!
# 2. Use App Passwords for email, not your main password
# 3. Rotate API keys every 90 days
# 4. Enable 2FA on all API provider accounts
# 5. Monitor API usage dashboards regularly
# ================================================================
